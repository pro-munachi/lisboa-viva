# Local Docker Compose database password.
POSTGRES_PASSWORD=lisboa_dev

# Use true when the public application is served over HTTPS.
COOKIE_SECURE=false

# Optional: restart the Go service after this account exists to grant its initial admin role.
BOOTSTRAP_ADMIN_HANDLE=

# Staging is configured in Render as a secret environment variable on the Go service.
# The supplied Railway proxy host is shown here without credentials intentionally.
# DATABASE_URL=postgres://USER:PASSWORD@zephyr.proxy.rlwy.net:25979/DATABASE?sslmode=require
