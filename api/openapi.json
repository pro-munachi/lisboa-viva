          "status",
          "appealed",
          "service_done",
          "evidence",
          "history"
        ]
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "player": {
            "$ref": "#/components/schemas/Player"
          },
          "now": {
            "type": "string"
          },
          "hour": {
            "type": "integer"
          },
          "weather": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "inventory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                }
              },
              "required": [
                "item",
                "quantity"
              ]
            }
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "qualification": {
                  "type": "string"
                }
              },
              "required": [
                "qualification"
              ]
            }
          },
          "nearby": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "handle": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "risk": {
                  "type": "string"
                }
              },
              "required": [
