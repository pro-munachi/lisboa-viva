              },
              "venue": {
                "type": "string"
              },
              "amount": {
                "type": "integer"
              }
            },
            "required": [
              "event",
              "venue",
              "amount"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
