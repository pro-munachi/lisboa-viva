        },
        "required": [
          "player",
          "now",
          "hour",
          "weather",
          "actions",
          "inventory",
          "qualifications",
          "nearby",
          "messages",
          "receipts",
          "encounters",
          "cases",
          "blocks"
        ]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lv_session"
      }
    }
  }
}
